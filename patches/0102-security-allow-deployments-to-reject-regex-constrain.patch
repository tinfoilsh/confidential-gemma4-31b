From 988df9754ab99c50df2f222161e831caab7f2b68 Mon Sep 17 00:00:00 2001
From: Jules Drean <jules@tinfoil.sh>
Date: Wed, 22 Jul 2026 08:13:14 +0000
Subject: security: allow deployments to reject regex constraints

---
 vllm/envs.py            | 6 ++++++
 vllm/sampling_params.py | 6 ++++++
 2 files changed, 12 insertions(+)

diff --git a/vllm/envs.py b/vllm/envs.py
index 13a19b86c..a681ebdd0 100755
--- a/vllm/envs.py
+++ b/vllm/envs.py
@@ -196,6 +196,7 @@ if TYPE_CHECKING:
     VLLM_FLASHINFER_WORKSPACE_BUFFER_SIZE: int = 394 * 1024 * 1024
     VLLM_XGRAMMAR_CACHE_MB: int = 0
     VLLM_REGEX_COMPILATION_TIMEOUT_S: int = 5
+    VLLM_DISABLE_STRUCTURED_OUTPUT_REGEX: bool = False
     VLLM_MSGPACK_ZERO_COPY_THRESHOLD: int = 256
     VLLM_ALLOW_INSECURE_SERIALIZATION: bool = False
     VLLM_DISABLE_REQUEST_ID_RANDOMIZATION: bool = False
@@ -1517,6 +1518,11 @@ environment_variables: dict[str, Callable[[], Any]] = {
     "VLLM_REGEX_COMPILATION_TIMEOUT_S": lambda: int(
         os.getenv("VLLM_REGEX_COMPILATION_TIMEOUT_S", "5")
     ),
+    # Reject user-provided structured-output regex constraints. This is a
+    # defense-in-depth option for public services that do not require regex.
+    "VLLM_DISABLE_STRUCTURED_OUTPUT_REGEX": lambda: bool(
+        int(os.getenv("VLLM_DISABLE_STRUCTURED_OUTPUT_REGEX", "0"))
+    ),
     # Control the threshold for msgspec to use 'zero copy' for
     # serialization/deserialization of tensors. Tensors below
     # this limit will be encoded into the msgpack buffer, and
diff --git a/vllm/sampling_params.py b/vllm/sampling_params.py
index 5df2e8cfc..a1a529119 100644
--- a/vllm/sampling_params.py
+++ b/vllm/sampling_params.py
@@ -904,6 +904,12 @@ class SamplingParams(
                 "Structured outputs requires a tokenizer so it can't be used with 'skip_tokenizer_init'"  # noqa: E501
             )
 
+        if (
+            envs.VLLM_DISABLE_STRUCTURED_OUTPUT_REGEX
+            and self.structured_outputs.regex is not None
+        ):
+            raise ValueError("structured_outputs.regex is disabled by the server")
+
         backend = structured_outputs_config.backend
         if _backend := self.structured_outputs._backend:
             # Request-level backend selection is not supported.
